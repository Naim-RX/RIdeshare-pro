{
  "name": "rideshare-pro-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "npm run test:validation && npm run test:ui",
    "test:validation": "node --test tests/*.test.cjs",
    "test:ui": "jest --runInBand",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check:dependencies": "expo install --check",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "expo": "~56.0.0",
    "react": "19.2.3",
    "react-native": "^0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~56.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.0",
    "react-test-renderer": "^19.2.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
