EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional, for local testing only. Use the PC LAN IP on a physical phone,
# 10.0.2.2 in the Android emulator, or 127.0.0.1 for local Node tests.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
# Native Maps SDK keys only. These are embedded in builds and must be app-restricted.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
# Never add GOOGLE_MAPS_SERVER_KEY here. It belongs in Functions Secret Manager.
